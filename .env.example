# Copy to .env and fill in. Never commit .env.
# Freqtrade reads FREQTRADE__<SECTION>__<KEY> env vars and overrides config.json.

# ---------- Postgres ----------
POSTGRES_PASSWORD=

# ---------- Freqtrade ----------
# Telegram bot (talk to @BotFather)
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# Binance keys — leave blank for week 1 dry-run.
# Fill once you create a Binance testnet account in week 6.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# FreqUI web dashboard login (http://localhost:8080)
FREQTRADE__API_SERVER__USERNAME=freqtrader
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=

# Strategy file in user_data/strategies/ to load (week 4 onwards: SentimentStrategy)
STRATEGY=SampleStrategy

# ---------- Ingest service (week 2) ----------
# Reddit: https://www.reddit.com/prefs/apps -> "create app" -> script
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=crypto-bot:v0.1
REDDIT_SUBREDDITS=cryptocurrency,bitcoin,cryptomarkets

# CryptoPanic: https://cryptopanic.com/developers/api/
CRYPTOPANIC_TOKEN=

# LunarCrush: https://lunarcrush.com/developers
LUNARCRUSH_TOKEN=

# Coins to track across all collectors
COINS=BTC,ETH,SOL,BNB

# ---------- Telegram channels (week 7) ----------
# my.telegram.org -> apps. Leave blank until week 7.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNELS=
