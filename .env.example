# Copy this file to .env and fill in real values. Never commit .env.
# Freqtrade reads these as FREQTRADE__<SECTION>__<KEY> env vars
# and overrides matching paths in user_data/config.json.

# Telegram bot (talk to @BotFather to create one)
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# Binance keys — leave blank for week 1 dry-run (uses public market data only)
# Fill these in once you create a Binance testnet account in week 6.
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# FreqUI web dashboard login (http://localhost:8080)
FREQTRADE__API_SERVER__USERNAME=freqtrader
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
